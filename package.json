{
  "name": "mcp-daily-tasks",
  "version": "2.0.0",
  "description": "MCP para manejar tareas y resúmenes con integración ClickUp.",
  "main": "dist/main.js",
  "type": "module",
  "author": "Stein Ivan",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steinivan/daily-resume.git"
  },
  "bugs": {
    "url": "https://github.com/steinivan/daily-resume/issues"
  },
  "keywords": [
    "mcp",
    "clickup",
    "tareas",
    "automatización"
  ],
  "files": [
    "dist/",
    "tools/"
  ],
  "dependencies": {
    "@huggingface/inference": "^4.0.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "mcp-daily-tasks": "file:mcp-daily-tasks.tgz",
    "node-cron": "^4.1.0",
    "node-fetch": "^2.6.7",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.24",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "test": "tsc && npx @modelcontextprotocol/inspector node dist/main.js",
    "build": "tsc",
    "copy-md": "cp -r tools/**/*.md dist/tools/",
    "pack": "node -e \"const fs=require('fs');const path=require('path');const pkg=require('./package.json');const tgz=`${pkg.name.replace(/\\//g,'-')}-${pkg.version}.tgz`;fs.existsSync('mcp-daily-tasks.tgz')&&fs.unlinkSync('mcp-daily-tasks.tgz');require('child_process').execSync('npm pack',{stdio:'inherit'});fs.renameSync(tgz,'mcp-daily-tasks.tgz');\""
  },
  "bin": {
    "mcp-daily-tasks": "dist/main.js"
  }
}
